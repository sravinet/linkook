{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/provider.schema.json",
    "title": "Provider Configuration",
    "description": "JSON Schema for linkook's provider configuration file with match/notMatch keywords",
    "type": "object",
    "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
            "type": "object",
            "properties": {
                "mainUrl": {
                    "type": "string",
                    "description": "Main home URL (e.g., 'https://github.com/')"
                },
                "profileUrl": {
                    "type": "string",
                    "description": "Profile URL template with '^USER^' for the user."
                },
                "queryUrl": {
                    "type": "string",
                    "description": "URL for API queries (if applicable)."
                },
                "regexUrl": {
                    "type": "string",
                    "description": "Regular expression for the profile URL."
                },
                "isConnected": {
                    "type": "boolean",
                    "description": "Indicates if this provider's profile page may list links to other social media."
                },
                "isUserID": {
                    "type": "boolean",
                    "description": "Indicates if the username is a user ID."
                },
                "hasEmail": {
                    "type": "boolean",
                    "description": "Indicates if the profile page has an email address."
                },
                "useGHunt": {
                    "type": "boolean",
                    "description": "Indicates if this provider should use GHunt for enhanced Google service scanning."
                },
                "ghuntConfig": {
                    "type": "object",
                    "description": "Configuration for GHunt-enabled providers",
                    "properties": {
                        "retryCount": {
                            "type": "integer",
                            "description": "Number of retries for GHunt operations",
                            "minimum": 1,
                            "default": 3
                        },
                        "requireAuth": {
                            "type": "boolean",
                            "description": "Whether GHunt authentication is required",
                            "default": true
                        },
                        "services": {
                            "type": "array",
                            "description": "List of GHunt services to use",
                            "items": {
                                "type": "string",
                                "enum": ["email", "gaia", "drive", "photos"]
                            }
                        }
                    },
                    "required": ["services"]
                },
                "keyword": {
                    "type": "object",
                    "description": "Match and notMatch keyword lists for existence checks.",
                    "properties": {
                        "Match": {
                            "type": "array",
                            "description": "A list of strings. If at least one is found, we consider the user 'found'.",
                            "items": {
                                "type": "string"
                            }
                        },
                        "notMatch": {
                            "type": "array",
                            "description": "A list of strings. If any are found, we consider the user 'not found'.",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "handle_regex": {
                    "type": "object",
                    "description": "Regular expressions for extracting handles from different platforms."
                },
                "request_method": {
                    "type": "string",
                    "enum": ["GET", "POST", "HEAD", "PUT"]
                },
                "request_payload": {
                    "type": "object"
                },
                "headers": {
                    "type": "object"
                },
                "options": {
                    "type": "array",
                    "description": "Optional array of extra parameters or info for advanced scanning.",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": ["profileUrl"],
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}